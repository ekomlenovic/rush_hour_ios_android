{
  "expo": {
    "name": "Rush Hours",
    "slug": "rush-hours",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "rush-hours",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rushhours.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Rush Hours connects to the multiplayer server you join, which can be on your local network."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.rushhours.app"
        ]
      }
    },
    "android": {
      "package": "com.rushhours.app",
      "versionCode": 20,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A2B4C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-localization",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A2B4C"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Rush Hours uses the camera to scan a level or server invitation QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withoutPushEntitlement",
      "./plugins/withOptionalCamera",
      [
        "expo-notifications",
        {
          "color": "#6C63FF"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdc1bf0b-e239-46b5-819b-401cbe9e2c83"
      }
    },
    "owner": "ekomlenovic"
  }
}
