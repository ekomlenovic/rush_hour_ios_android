<?xml version="1.0" encoding="utf-8"?>
<!-- Redrawn by the app at each progress, at midnight (alarm) and every 30 min at least -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/rush_widget_small_description"
    android:initialLayout="@layout/rush_widget_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/rush_widget_small"
    android:resizeMode="none"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
