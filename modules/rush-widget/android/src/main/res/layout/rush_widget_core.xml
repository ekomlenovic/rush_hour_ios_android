<?xml version="1.0" encoding="utf-8"?>
<!--
  Streak, freezes and daily challenge, shared by both widgets (StreakWidgets.kt), or the message
  saying to open the app while it has written nothing.
  Read in one go: the root of the widget has the whole description.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:id="@+id/rush_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rush_widget_flame"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/rush_widget_flame" />

            <TextView
                android:id="@+id/rush_widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="7"
                android:textColor="@color/rush_widget_text"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/rush_widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rush_widget_unit"
            android:textColor="@color/rush_widget_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rush_widget_slot_0"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rush_widget_slot_filled"
                android:padding="2dp"
                android:src="@drawable/rush_widget_snow_filled" />

            <ImageView
                android:id="@+id/rush_widget_slot_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rush_widget_slot_filled"
                android:padding="2dp"
                android:src="@drawable/rush_widget_snow_filled" />

            <ImageView
                android:id="@+id/rush_widget_slot_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rush_widget_slot_empty"
                android:padding="2dp"
                android:src="@drawable/rush_widget_snow_empty" />

            <ImageView
                android:id="@+id/rush_widget_slot_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rush_widget_slot_empty"
                android:padding="2dp"
                android:src="@drawable/rush_widget_snow_empty"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/rush_widget_slot_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/rush_widget_slot_empty"
                android:padding="2dp"
                android:src="@drawable/rush_widget_snow_empty"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/rush_widget_slot_5"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/rush_widget_slot_empty"
                android:padding="2dp"
                android:src="@drawable/rush_widget_snow_empty"
                android:visibility="gone" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/rush_widget_daily"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rush_widget_daily"
            android:textColor="@color/rush_widget_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rush_widget_status_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/rush_widget_todo" />

            <TextView
                android:id="@+id/rush_widget_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/rush_widget_todo"
                android:textColor="@color/rush_widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rush_widget_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/rush_widget_done"
                android:textColor="@color/rush_widget_success"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/rush_widget_star_0"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/rush_widget_star"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/rush_widget_star_1"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="1dp"
                android:src="@drawable/rush_widget_star"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/rush_widget_star_2"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="1dp"
                android:src="@drawable/rush_widget_star"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <!-- Nothing written by the app yet: says so rather than showing a streak at 0 -->
    <LinearLayout
        android:id="@+id/rush_widget_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rush_widget_flame_off" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="4"
            android:text="@string/rush_widget_open_app"
            android:textColor="@color/rush_widget_text"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
