<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 widget: the 2×2 content, then the countdown, "streak in danger" or "tap to play" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rush_widget_background"
    android:clipToOutline="true"
    android:contentDescription="@string/rush_widget_empty_label"
    android:orientation="horizontal"
    android:padding="14dp">

    <include
        layout="@layout/rush_widget_core"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/rush_widget_divider"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/rush_widget_extra_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/rush_widget_play" />

        <TextView
            android:id="@+id/rush_widget_extra_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/rush_widget_play"
            android:textColor="@color/rush_widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rush_widget_extra_danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/rush_widget_danger"
            android:textColor="@color/rush_widget_danger"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rush_widget_extra_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="@string/rush_widget_time_left"
            android:textColor="@color/rush_widget_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <Chronometer
            android:id="@+id/rush_widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/rush_widget_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
